#-----------------------------------------------------------
#
# Surface explosion on soft topsoil recorded by a horizontal DAS fibre
# buried 1 m deep.  SPECFEM2D 8.1.
#
# Mesh coordinates: origin at the lower-left corner, z pointing up.  The free
# surface is z = 50 m, so a point d metres below it has z = 50 - d.
#
# Every parameter must be present, even unused ones: the parser stops on a
# missing name.
#
#-----------------------------------------------------------

#-----------------------------------------------------------
#
# Simulation input parameters
#
#-----------------------------------------------------------

# title of job
title                           = Surface blast on soft soil, 1 m deep DAS fibre

# forward or adjoint simulation
# 1 = forward, 2 = adjoint, 3 = both simultaneously
SIMULATION_TYPE                 = 1
# 0 = regular wave propagation simulation, 1/2/3 = noise simulation
NOISE_TOMOGRAPHY                = 0
# save the last frame, needed for adjoint simulation
SAVE_FORWARD                    = .false.

# parameters concerning partitioning
NPROC                           = 1              # number of processes

# total number of time steps
# 8000 x 5e-5 s = 0.4 s.  The Rayleigh wave (186.5 m/s) has passed both fibre
# ends (40 m offset) by ~0.24 s; the rest of the record shows whether anything
# comes back from the absorbing boundaries.
NSTEP                           = 8000

# duration of a time step
# Courant number = Vp * DT / (smallest GLL spacing) = 400 * 5e-5 / (0.1727 * 0.5) = 0.23
# (the solver suggests <= 0.5 and prints the value it finds)
DT                              = 5.0d-5

# time stepping
# 1 = Newmark (2nd order), 2 = LDDRK4-6 (4th-order 6-stage low storage Runge-Kutta), 3 = classical RK4 4th-order 4-stage Runge-Kutta
time_stepping_scheme            = 1

# P-SV: in-plane motion (UX, UZ) carrying P, SV and Rayleigh waves
P_SV                            = .true.

# axisymmetric (2.5D) or Cartesian planar (2D) simulation
AXISYM                          = .false.

#-----------------------------------------------------------
#
# Mesh
#
#-----------------------------------------------------------

# Partitioning algorithm for decompose_mesh
PARTITIONING_TYPE               = 3              # SCOTCH = 3, ascending order (very bad idea) = 1

# number of control nodes per element (4 or 9); 4 is exact for straight-sided elements
NGNOD                           = 4

# creates/reads a binary database that allows to skip all time consuming setup steps in initialization
# 0 = does not read/create database, 1 = creates database, 2 = reads database
setup_with_binary_database      = 0

# default = define the model with nbmodels below
MODEL                           = default

# Output the model with the requested type, does not save if turn to default or .false.
SAVE_MODEL                      = default

# external tomography file
TOMOGRAPHY_FILE                 = dummy

#-----------------------------------------------------------
#
# Attenuation
#
#-----------------------------------------------------------

# attenuation parameters (purely elastic run)
ATTENUATION_VISCOELASTIC        = .false.
ATTENUATION_VISCOACOUSTIC       = .false.

# for viscoelastic or viscoacoustic attenuation
N_SLS                           = 3
ATTENUATION_f0_REFERENCE        = 50.
READ_VELOCITIES_AT_f0           = .false.
USE_SOLVOPT                     = .false.

# for poroelastic attenuation
ATTENUATION_PORO_FLUID_PART     = .false.
Q0_poroelastic                  = 1
freq0_poroelastic               = 10

# for electromagnetic attenuation
ATTENUATION_PERMITTIVITY        = .false.
ATTENUATION_CONDUCTIVITY        = .false.
f0_electromagnetic              = 1.d9

# undo attenuation and/or PMLs for kernel calculations
UNDO_ATTENUATION_AND_OR_PML     = .false.
NT_DUMP_ATTENUATION             = 500

# read the forward wavefield from disk instead of reconstructing it
NO_BACKWARD_RECONSTRUCTION      = .false.

#-----------------------------------------------------------
#
# Sources
#
#-----------------------------------------------------------

# source parameters (the source itself is in DATA/SOURCE)
NSOURCES                        = 1
force_normal_to_surface         = .false.

# medium initially at rest
initialfield                    = .false.
add_Bielak_conditions_bottom    = .false.
add_Bielak_conditions_right     = .false.
add_Bielak_conditions_top       = .false.
add_Bielak_conditions_left      = .false.

# acoustic forcing
ACOUSTIC_FORCING                = .false.

# noise simulations - type of noise source time function
noise_source_time_function_type = 4

# moving sources
write_moving_sources_database   = .false.

# writes OUTPUT_FILES/plot_source_time_function.txt
PRINT_SOURCE_TIME_FUNCTION      = .true.

#-----------------------------------------------------------
#
# Receivers
#
#-----------------------------------------------------------

# seismotype : record 1=displ 2=veloc 3=accel 4=pressure 5=curl of displ 6=the fluid potential 7=electric field
# 1 writes UX and UZ for every station: OUTPUT_FILES/AA.S0001.FXX.semd and .FXZ.semd
# (the band letter follows the output sample interval: F for <= 1 ms)
seismotype                      = 1

# every how many time steps we save the seismograms; larger than NSTEP = once, at the end
NTSTEP_BETWEEN_OUTPUT_SEISMOS   = 10000

# keep every 10th step: traces sampled at 2 kHz (Nyquist 1 kHz; the mesh resolves ~320 Hz)
NTSTEP_BETWEEN_OUTPUT_SAMPLE    = 10

# so far, this option can only be used if all the receivers are in acoustic elements
USE_TRICK_FOR_BETTER_PRESSURE   = .false.

# 0 = automatic start time, -t0 with t0 = 1.2 / f0 = 24 ms for a Ricker
USER_T0                         = 0.0d0

# seismogram formats
save_ASCII_seismograms          = .true.
save_binary_seismograms_single  = .false.
save_binary_seismograms_double  = .false.
SU_FORMAT                       = .false.

# read the fibre channels from DATA/STATIONS (written by make_stations.py)
use_existing_STATIONS           = .true.

# The receiver set below is the same fibre (81 channels, x = 10..90 m, 1 m deep);
# it is only used when use_existing_STATIONS = .false.
nreceiversets                   = 1

# orientation
anglerec                        = 0.d0
rec_normal_to_surface           = .false.

# receiver set 1
nrec                            = 81
xdeb                            = 10.
zdeb                            = 49.
xfin                            = 90.
zfin                            = 49.
record_at_surface_same_vertical = .false.

#-----------------------------------------------------------
#
# adjoint kernel outputs
#
#-----------------------------------------------------------

SAVE_ASCII_KERNELS              = .true.
SAVE_KERNEL_WEIGHTS             = .false.
NTSTEP_BETWEEN_COMPUTE_KERNELS  = 1
APPROXIMATE_HESS_KL             = .false.

#-----------------------------------------------------------
#
# Boundary conditions
#
#-----------------------------------------------------------

# C-PML on every edge flagged absorbing below (left, right, bottom); the top
# stays a free surface.  The PML is taken from inside the mesh, not added to
# it: 10 elements = 5 m, leaving x = 5..95 m and depths 0..45 m unabsorbed.
# Checked against a 220 m x 90 m run with no reflections in the window: the fibre
# strain differs by < 0.02 % of any channel's peak.  Stacey reflects up to 22 %.
PML_BOUNDARY_CONDITIONS         = .true.
NELEM_PML_THICKNESS             = 10
ROTATE_PML_ACTIVATE             = .false.
ROTATE_PML_ANGLE                = 30.
# damping profiles inside the PMLs
K_MIN_PML                       = 1.0d0
K_MAX_PML                       = 1.0d0
damping_change_factor_acoustic  = 0.5d0
damping_change_factor_elastic   = 1.0d0
PML_PARAMETER_ADJUSTMENT        = .false.

# Stacey ABC: to use it instead, set this .true. and PML_BOUNDARY_CONDITIONS .false.
STACEY_ABSORBING_CONDITIONS     = .false.

# periodic boundaries
ADD_PERIODIC_CONDITIONS         = .false.
PERIODIC_HORIZ_DIST             = 4000.d0

#-----------------------------------------------------------
#
# MESHING - Velocity and density models
#
#-----------------------------------------------------------

# use the internal mesher
read_external_mesh              = .false.

#-----------------------------------------------------------
#
# PARAMETERS FOR EXTERNAL MESHING (unused)
#
#-----------------------------------------------------------

mesh_file                       = dummy
nodes_coords_file               = dummy
materials_file                  = dummy
nummaterial_velocity_file       = dummy
free_surface_file               = dummy
axial_elements_file             = dummy
absorbing_surface_file          = dummy
acoustic_forcing_surface_file   = dummy
absorbing_cpml_file             = dummy
tangential_detection_curve_file = dummy

#-----------------------------------------------------------
#
# PARAMETERS FOR INTERNAL MESHING
#
#-----------------------------------------------------------

# number of model materials
nbmodels                        = 1
# elastic: model_number 1 rho Vp Vs 0 0 QKappa Qmu 0 0 0 0 0 0 (9999 = no attenuation)
# soft topsoil: rho = 1800 kg/m^3, Vp = 400 m/s, Vs = 200 m/s (Poisson ratio 1/3)
1 1 1800.d0 400.d0 200.d0 0 0 9999 9999 0 0 0 0 0 0

# interfaces for the internal mesh, read from DATA/
interfacesfile                  = interfaces.dat

# geometry of the model (origin lower-left corner = 0,0) and mesh description
xmin                            = 0.d0
xmax                            = 100.d0
nx                              = 200            # 0.5 m elements (100 vertical ones are set in interfaces.dat)

# absorbing boundary parameters
absorbbottom                    = .true.
absorbright                     = .true.
absorbtop                       = .false.        # free surface: Rayleigh waves travel along it
absorbleft                      = .true.

# regions of the (nx, nz) spectral-element mesh
nbregions                       = 1
# format of each line: nxmin nxmax nzmin nzmax material_number
1 200 1 100 1

#-----------------------------------------------------------
#
# Display parameters
#
#-----------------------------------------------------------

# interval at which we output time step info and max of norm of displacement
NTSTEP_BETWEEN_OUTPUT_INFO      = 500

# save mesh files (VTK, ASCII or Gnuplot) to check the mesh
SAVE_MESH_FILES                 = .false.

# meshing output
output_grid_Gnuplot             = .false.
output_grid_ASCII               = .false.

# total energy curves, e.g. to monitor how the PMLs behave (a bit expensive)
OUTPUT_ENERGY                   = .false.
NTSTEP_BETWEEN_OUTPUT_ENERGY    = 10

# integrated energy field
COMPUTE_INTEGRATED_ENERGY_FIELD = .false.

#-----------------------------------------------------------
#
# Movies/images/snaphots visualizations
#
#-----------------------------------------------------------

# a JPEG of the UX wavefield every 20 ms, to check the Rayleigh wave and the PMLs by eye
NTSTEP_BETWEEN_OUTPUT_IMAGES    = 400

# minimum amplitude kept in % for the JPEG and PostScript snapshots; amplitudes below that are muted
cutsnaps                        = 1.

#### for JPEG color images ####
output_color_image              = .true.
imagetype_JPEG                  = 1              # 1=displ_Ux 2=displ_Uz 3=displ_norm 4=veloc_Vx 5=veloc_Vz 6=veloc_norm 7=accel_Ax 8=accel_Az 9=accel_norm 10=pressure
factor_subsample_image          = 1.0d0
USE_CONSTANT_MAX_AMPLITUDE      = .false.
CONSTANT_MAX_AMPLITUDE_TO_USE   = 1.17d4
POWER_DISPLAY_COLOR             = 0.30d0
DRAW_SOURCES_AND_RECEIVERS      = .true.
DRAW_WATER_IN_BLUE              = .true.
USE_SNAPSHOT_NUMBER_IN_FILENAME = .false.

#### for PostScript snapshots ####
output_postscript_snapshot      = .false.
imagetype_postscript            = 1
meshvect                        = .true.
modelvect                       = .false.
boundvect                       = .true.
interpol                        = .true.
pointsdisp                      = 6
subsamp_postscript              = 1
sizemax_arrows                  = 1.d0
US_LETTER                       = .false.

#### for wavefield dumps ####
output_wavefield_dumps          = .false.
imagetype_wavefield_dumps       = 1
use_binary_for_wavefield_dumps  = .false.

#-----------------------------------------------------------

# several independent runs from within the same job
NUMBER_OF_SIMULTANEOUS_RUNS     = 1
BROADCAST_SAME_MESH_AND_MODEL   = .true.

#-----------------------------------------------------------

# set to true to use GPUs
GPU_MODE                        = .false.
