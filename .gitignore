# Virtualenv
.venv/

# Generated datasets (~6 GB). Rebuild byte-for-byte with the command recorded
# in manifest.json, e.g.
#   uv run python make_dataset.py --out data/synthetic/v2
# The manifests are kept: they carry the argv, seeds, library versions and a
# sha256 per recording.
data/**
!data/**/
!data/**/manifest.json
# the showcase figure is a deliverable, not a generated dataset
!data/showcase/*.png

# Training artifacts (checkpoints, scores, logs)
runs/

# Rail dashboard GTFS feed (~96 MB). dashboard/rail_data.js, built from it, is
# committed because the Render static site serves dashboard/ as-is.
# Rebuild with: uv run python dashboard/build_rail_data.py
polish_trains/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
